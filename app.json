{
  "expo": {
    "newArchEnabled": true,
    "name": "echoes",
    "slug": "echoes",
    "scheme": "echoes",
    "version": "3.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#13121E"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.sophiehorner.echoes",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "UIRequiredDeviceCapabilities": ["arm64", "arkit"],
        "NSCameraUsageDescription": "ECHOES a besoin de la caméra pour afficher les souvenirs en Réalité Augmentée.",
        "NSLocationWhenInUseUsageDescription": "ECHOES utilise votre position pour afficher les souvenirs proches.",
        "NSPhotoLibraryUsageDescription": "ECHOES a besoin d'accéder aux photos pour les souvenirs.",
        "NSPhotoLibraryAddUsageDescription": "ECHOES a besoin d'enregistrer les souvenirs dans vos photos.",
        "NSMicrophoneUsageDescription": "ECHOES a besoin du microphone pour les souvenirs audio."
      }
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#13121E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.sophiehorner.echoes",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "17.6"
          },
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "buildToolsVersion": "36.0.0"
          }
        }
      ],
      "./plugins/withAndroidBuildConfig",
      "react-native-compressor",
      "./plugins/withEchoesGmsCleanup",
      "@maplibre/maplibre-react-native",
      [
        "@reactvision/react-viro",
        {
          "android": {
            "xRMode": "AR"
          },
          "ios": {
            "cameraUsagePermission": "ECHOES a besoin de la caméra pour afficher les souvenirs en Réalité Augmentée.",
            "microphoneUsagePermission": "ECHOES a besoin du microphone pour les souvenirs audio.",
            "photosPermission": "ECHOES a besoin d'accéder aux photos pour les souvenirs.",
            "savePhotosPermission": "ECHOES a besoin d'enregistrer les souvenirs dans vos photos."
          }
        }
      ],
      "./plugins/withEchoesLocation"
    ]
  }
}
